# Copy to .env. AWS values are read from ../infra/cdk-outputs.json after deploy,
# so you only need these if you want to override them.
PORT=4000
DATABASE_URL=postgres://twin:twin@localhost:5434/twin
CLIENT_ORIGIN=http://localhost:5173

# Which local AWS profile the backend uses (needs Rekognition access).
AWS_PROFILE=default

# Optional overrides (normally taken from cdk-outputs.json)
# AWS_REGION=us-east-1
# COLLECTION_ID=twin-resolver-faces

# Search threshold. Lower it in testing to force lookalike collisions (see plan).
FACE_MATCH_THRESHOLD=90
# Minimum Face Liveness confidence to accept a session.
LIVENESS_MIN_CONFIDENCE=90

# Signs session and match tokens. Any long random string, e.g. `openssl rand -hex 32`.
# If unset, a random one is used per run and tokens stop working after a restart.
TOKEN_SECRET=

# Review queue: the admin page sends this as X-Admin-Token. Unset = admin endpoints disabled.
ADMIN_TOKEN=
