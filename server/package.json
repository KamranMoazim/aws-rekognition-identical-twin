{
  "name": "twin-resolver-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:claims": "tsx test/claims.test.ts",
    "test:rules": "tsx test/copresence-rules.test.ts",
    "test": "npm run test:rules && npm run test:claims && npm run test:copresence && npm run test:pins && npm run test:hardening",
    "test:copresence": "tsx test/copresence.test.ts",
    "test:pins": "tsx test/pins.test.ts",
    "test:hardening": "tsx test/hardening.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1127.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
